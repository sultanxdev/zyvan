// ─────────────────────────────────────────────────────────────────────────────
// Zyvan — Prisma Schema
// PostgreSQL is the system of record for all auth, tenant, event, and delivery state.
// Incorporates Better Auth Core, Better Auth Organization plugin, and strict
// organization-scoped tenant isolation across all domain models.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum ProjectStatus {
  active
  disabled
}

enum EventStatus {
  queued
  delivering
  retrying
  delivered
  dead_letter
  expired
  cancelled
}

enum DeliveryStatus {
  queued
  processing
  delivering
  retrying
  delivered
  failed
  cancelled
}

enum AttemptOutcome {
  success
  failed
  timeout
  error
}

enum ReplayStatus {
  queued
  delivering
  delivered
  resolved
  failed
}

enum DeadLetterReason {
  terminal_4xx
  retries_exhausted
  ssrf_blocked
  timeout
  other
}

enum DeadLetterStatus {
  open
  replaying
  resolved
  dismissed
}

// ─── Better Auth Core Models ──────────────────────────────────────────────────

model User {
  id            String    @id
  name          String    @db.VarChar(255)
  email         String    @unique @db.VarChar(255)
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?   @db.VarChar(512)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  sessions    Session[]
  accounts    Account[]
  members     Member[]
  invitations Invitation[]
  auditLogs   AuditLog[]

  @@map("users")
}

model Session {
  id                   String   @id
  expiresAt            DateTime @map("expires_at")
  token                String   @unique @db.VarChar(255)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  ipAddress            String?  @map("ip_address") @db.VarChar(45)
  userAgent            String?  @map("user_agent") @db.Text
  userId               String   @map("user_id")
  activeOrganizationId String?  @map("active_organization_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id") @db.VarChar(255)
  providerId            String    @map("provider_id") @db.VarChar(100) // e.g. "google", "github", "credential"
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token") @db.Text
  refreshToken          String?   @map("refresh_token") @db.Text
  idToken               String?   @map("id_token") @db.Text
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?   @db.Text
  password              String?   @db.VarChar(255)
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String   @db.VarChar(255)
  value      String   @db.Text
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

// ─── Better Auth Organization Plugin Models (Tenant Boundary) ─────────────────

model Organization {
  id        String   @id
  name      String   @db.VarChar(255)
  slug      String?  @unique @db.VarChar(255)
  logo      String?  @db.VarChar(512)
  createdAt DateTime @default(now()) @map("created_at")
  metadata  String?  @db.Text

  members     Member[]
  invitations Invitation[]

  // Zyvan Domain Resources (Organization-Scoped)
  projects     Project[]
  destinations Destination[]
  events       Event[]
  deliveries   Delivery[]
  apiKeys        ApiKey[]
  auditLogs      AuditLog[]
  outboxMessages OutboxMessage[]
  deadLetters    DeadLetter[]
  replays        Replay[]
  replayBatches  ReplayBatch[]

  @@map("organizations")
}

model Member {
  id             String   @id
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  role           String   @default("member") @db.VarChar(50) // owner | admin | member | viewer
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("members")
}

model Invitation {
  id             String   @id
  organizationId String   @map("organization_id")
  email          String   @db.VarChar(255)
  role           String?  @db.VarChar(50)
  status         String   @default("pending") @db.VarChar(50)
  expiresAt      DateTime @map("expires_at")
  inviterId      String   @map("inviter_id")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("invitations")
}

// ─── Projects (Tenant-Scoped) ────────────────────────────────────────────────

model Project {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String        @map("organization_id")
  name           String        @db.VarChar(255)
  slug           String?       @db.VarChar(255)
  plan           String        @default("free") @db.VarChar(50)
  status         ProjectStatus @default(active)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  apiKeys      ApiKey[]
  destinations Destination[]
  events       Event[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("projects")
}

// ─── Project Machine API Keys ────────────────────────────────────────────────

model ApiKey {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId      String    @map("project_id") @db.Uuid
  organizationId String    @map("organization_id")
  keyHash        String    @unique @map("key_hash") @db.VarChar(255)
  keyPrefix      String    @map("key_prefix") @db.VarChar(20) // e.g. "zyvan_live_abc"
  name           String    @db.VarChar(255)
  scopes         String[]  @default([])
  expiresAt      DateTime? @map("expires_at")
  revokedAt      DateTime? @map("revoked_at")
  lastUsedAt     DateTime? @map("last_used_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([organizationId])
  @@map("api_keys")
}

// ─── Destinations ────────────────────────────────────────────────────────────

model Destination {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId      String   @map("project_id") @db.Uuid
  organizationId String   @map("organization_id")
  url            String   @db.VarChar(2048)
  secretRef      String?  @map("secret_ref") @db.Text // Encrypted signing secret
  retryPolicy    Json     @default("{}") @map("retry_policy") // { maxAttempts, baseDelay, maxDelay }
  rateLimit      Int      @default(20) @map("rate_limit") // requests per second
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries   Delivery[]
  deadLetters  DeadLetter[]

  @@index([projectId])
  @@index([organizationId])
  @@map("destinations")
}

// ─── Events ──────────────────────────────────────────────────────────────────

model Event {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId      String      @map("project_id") @db.Uuid
  organizationId String      @map("organization_id")
  eventType      String      @map("event_type") @db.VarChar(255)
  idempotencyKey String      @map("idempotency_key") @db.VarChar(255)
  payload        Json        @default("{}")
  headers        Json        @default("{}")
  status         EventStatus @default(queued)
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries   Delivery[]
  replays      Replay[]
  deadLetters  DeadLetter[]

  @@unique([projectId, idempotencyKey])
  @@index([projectId])
  @@index([organizationId])
  @@index([eventType])
  @@index([status])
  @@index([createdAt])
  @@map("events")
}

// ─── Deliveries ──────────────────────────────────────────────────────────────

model Delivery {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String         @map("organization_id")
  eventId        String         @map("event_id") @db.Uuid
  destinationId  String         @map("destination_id") @db.Uuid
  status         DeliveryStatus @default(queued)
  attemptCount   Int            @default(0) @map("attempt_count")
  nextRetryAt    DateTime?      @map("next_retry_at")
  lastStatusCode Int?           @map("last_status_code")
  processingAt   DateTime?      @map("processing_at")
  leaseExpiresAt DateTime?      @map("lease_expires_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  destination   Destination    @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  attempts      Attempt[]
  replay        Replay?        @relation("ReplayDelivery")
  replaysFromOriginal Replay[] @relation("OriginalDeliveryReplays")
  deadLetter    DeadLetter?
  outboxMessage OutboxMessage?

  @@index([organizationId])
  @@index([eventId])
  @@index([destinationId])
  @@index([status])
  @@index([nextRetryAt])
  @@index([leaseExpiresAt])
  @@map("deliveries")
}

// ─── Attempts ────────────────────────────────────────────────────────────────

model Attempt {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deliveryId   String         @map("delivery_id") @db.Uuid
  attemptNo    Int            @map("attempt_no")
  startedAt    DateTime       @default(now()) @map("started_at")
  endedAt      DateTime?      @map("ended_at")
  response     Json?
  statusCode   Int?           @map("status_code")
  latencyMs    Int?           @map("latency_ms")
  outcome      AttemptOutcome
  errorMessage String?        @map("error_message") @db.Text

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId])
  @@map("attempts")
}

// ─── Replay Batches (Bulk Replay Idempotency) ────────────────────────────────

model ReplayBatch {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id")
  idempotencyKey String    @map("idempotency_key") @db.VarChar(255)
  status         String    @default("accepted") @db.VarChar(50)
  requested      Int       @default(0)
  accepted       Int       @default(0)
  skipped        Int       @default(0)
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  replays      Replay[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, createdAt])
  @@map("replay_batches")
}

// ─── Replays ─────────────────────────────────────────────────────────────────

model Replay {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String       @map("organization_id")
  eventId            String       @map("event_id") @db.Uuid
  deadLetterId       String?      @map("dead_letter_id") @db.Uuid
  originalDeliveryId String?      @map("original_delivery_id") @db.Uuid
  deliveryId         String       @unique @map("delivery_id") @db.Uuid
  batchId            String?      @map("batch_id") @db.Uuid
  idempotencyKey     String?      @map("idempotency_key") @db.VarChar(255)
  requestedBy        String?      @map("requested_by") @db.VarChar(255)
  status             ReplayStatus @default(queued)
  failureReason      String?      @map("failure_reason") @db.Text
  completedAt        DateTime?    @map("completed_at")
  createdAt          DateTime     @default(now()) @map("created_at")

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  event            Event        @relation(fields: [eventId], references: [id], onDelete: Restrict)
  delivery         Delivery     @relation("ReplayDelivery", fields: [deliveryId], references: [id], onDelete: Restrict)
  originalDelivery Delivery?    @relation("OriginalDeliveryReplays", fields: [originalDeliveryId], references: [id], onDelete: SetNull)
  deadLetter       DeadLetter?  @relation(fields: [deadLetterId], references: [id], onDelete: SetNull)
  batch            ReplayBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([deadLetterId])
  @@index([eventId])
  @@index([batchId])
  @@unique([deadLetterId, idempotencyKey])
  @@map("replays")
}

// ─── Dead Letters ────────────────────────────────────────────────────────────

model DeadLetter {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @map("organization_id")
  eventId        String           @map("event_id") @db.Uuid
  deliveryId     String           @unique @map("delivery_id") @db.Uuid
  destinationId  String           @map("destination_id") @db.Uuid
  status         DeadLetterStatus @default(open)
  reason         DeadLetterReason @default(other)
  errorMessage   String?          @map("error_message") @db.Text
  statusCode     Int?             @map("status_code")
  attemptCount   Int              @default(1) @map("attempt_count")
  replayedAt      DateTime?        @map("replayed_at")
  resolvedAt      DateTime?        @map("resolved_at")
  resolvedBy      String?          @map("resolved_by")
  resolution      String?          @db.Text
  dismissedAt     DateTime?        @map("dismissed_at")
  dismissedBy     String?          @map("dismissed_by")
  dismissalReason String?          @map("dismissal_reason") @db.Text
  createdAt       DateTime         @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Restrict)
  delivery     Delivery     @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  destination  Destination  @relation(fields: [destinationId], references: [id], onDelete: Restrict)
  replays      Replay[]

  @@index([organizationId, createdAt, id])
  @@index([organizationId, status, createdAt, id])
  @@index([organizationId, reason, createdAt])
  @@index([organizationId, destinationId, createdAt, id])
  @@index([eventId])
  @@map("dead_letters")
}

// ─── Audit Logs ──────────────────────────────────────────────────────────────

model AuditLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id")
  userId         String?  @map("user_id")
  action         String   @db.VarChar(100)
  resourceType   String   @map("resource_type") @db.VarChar(100)
  resourceId     String?  @map("resource_id") @db.VarChar(255)
  metadata       Json?    @default("{}")
  ipAddress      String?  @map("ip_address") @db.VarChar(45)
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── Outbox Messages (Durable Transactional Synchronization) ─────────────────

model OutboxMessage {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id")
  deliveryId     String    @unique @map("delivery_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  lockedAt       DateTime? @map("locked_at")
  lockedBy       String?   @map("locked_by") @db.VarChar(255)
  attempts       Int       @default(0)
  lastError      String?   @map("last_error") @db.Text

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  delivery       Delivery     @relation(fields: [deliveryId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([lockedAt, createdAt])
  @@index([organizationId, createdAt])
  @@map("outbox_messages")
}

