# ─── Application ───────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Database (PostgreSQL) ─────────────────────────
DATABASE_URL=postgresql://zyvan:zyvan_secret@localhost:5432/zyvan_dev?schema=public

# ─── Queue (RabbitMQ) ──────────────────────────────
RABBITMQ_URL=amqp://zyvan:zyvan_secret@localhost:5672

# ─── Redis (Sessions/Rate Limits) ──────────────────
REDIS_URL=redis://localhost:6379

# ─── Better Auth & Security ────────────────────────
BETTER_AUTH_SECRET=change-me-to-a-random-32-byte-secret-in-production
BETTER_AUTH_URL=http://localhost:4000
CLIENT_ORIGIN=http://localhost:3000

# OAuth Providers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Machine API Keys & Webhook Crypto
API_KEY_PEPPER=change-me-to-a-random-64-char-hex-string
ENCRYPTION_KEY=change-me-to-a-random-32-byte-hex-key
HMAC_KEY_VERSION=v1

# ─── Logging ───────────────────────────────────────
LOG_LEVEL=info
